{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=cirs_db;Uid=root;Pwd=Password123@;"
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5,
    "CookieExpireMinutes": 30,
    "SessionIdleMinutes": 30,
    "RememberMeDays": 7,
    "BcryptWorkFactor": 11
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
