@model ErrorViewModel
@{
    var isNotFound = Model.StatusCode == 404;
    var isExpiredForm = Model.StatusCode == 400;
    ViewData["Title"] = isNotFound ? "Page not found" : isExpiredForm ? "Form expired" : "Something went wrong";
}

<section class="card">
    @if (isNotFound)
    {
        <h1>Page not found</h1>
        <p>The page you asked for does not exist.</p>
    }
    else if (isExpiredForm)
    {
        <h1>This form has expired</h1>
        <p>The page was open for too long or its security token no longer matches. Go back, refresh the page and try again.</p>
    }
    else
    {
        <h1>Something went wrong</h1>
        <p>Sorry, the request could not be completed. The problem has been recorded so it can be fixed.</p>
        @if (!string.IsNullOrEmpty(Model.ErrorId))
        {
            <p>Reference id: <code>@Model.ErrorId</code></p>
        }
    }
    <p><a class="button" asp-controller="Home" asp-action="Index">Back to home</a></p>
</section>
